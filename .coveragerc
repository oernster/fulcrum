[run]
source = fulcrum

[report]
show_missing = True
skip_covered = False
fail_under = 100

omit =
    */main.py
    */ui/*
    */shared/resources.py
    */application/interfaces.py
    */version.py
    */__pycache__/*
    */venv/*
    */generate_icons.py
    */installer/app.py
    */installer/installer_bundle.py
    */installer/installer_lifecycle.py
    */installer/installer_ops.py
    */installer/installer_theme.py
    */installer/installer_widgets.py
    */installer/installer_window.py
    */installer/payload/*
